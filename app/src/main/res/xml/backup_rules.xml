<?xml version="1.0" encoding="utf-8"?><!--
   Android 11 and lower (API 30-). Backups are off (android:allowBackup="false"); these rules
   exclude everything as well, so nothing is backed up if that flag is ever turned on again.
   On API 31+ this file is ignored: see data_extraction_rules.xml.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
